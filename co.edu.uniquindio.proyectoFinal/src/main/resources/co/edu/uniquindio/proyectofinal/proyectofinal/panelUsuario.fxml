<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="698.0" prefWidth="922.0" spacing="20.0" style="-fx-padding: 30" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.viewController.PanelUsuarioViewController">
    <children>
        <HBox prefHeight="100.0" prefWidth="739.0">
            <children>
                <Label text="Panel principal" textAlignment="JUSTIFY" wrapText="true">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton mnemonicParsing="false" text="Menu">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#irActualizar" text="Actualizar datos" />
                        <MenuItem mnemonicParsing="false" onAction="#irCrearCuentaBancaria" text="Crear nueva cuenta" />
                        <MenuItem mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesion">
                        </MenuItem>
                    </items>
                </MenuButton>
            </children>
        </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="A continuación, podrá buscar sus transacciones, indicando la categoria, tipo o fecha de la transaccion:">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Region prefHeight="22.0" prefWidth="32.0" />
            <Label text="Categoria: ">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="22.0" prefWidth="98.0" />
            <Label text="Tipo Transacción:">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="22.0" prefWidth="93.0" />
            <Label text="Fecha:">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="TOP_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="26.0" prefWidth="859.0">
         <children>
            <TextField fx:id="txtNombreCategoria" />
            <Region prefHeight="26.0" prefWidth="31.0" />
            <ComboBox fx:id="comboTipoTransaccion" onAction="#seleccionarTipoTransaccion" prefWidth="150.0" />
            <Region prefHeight="26.0" prefWidth="26.0" />
            <DatePicker fx:id="dpFechaTransaccion" onAction="#seleccionarFechaTransaccion" />
            <Region prefHeight="26.0" prefWidth="39.0" />
            <Separator orientation="VERTICAL" prefHeight="26.0" prefWidth="12.0" />
            <Region prefHeight="26.0" prefWidth="26.0" />
            <Label alignment="CENTER" contentDisplay="CENTER" text="Cuentas:">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Region prefHeight="26.0" prefWidth="26.0" />
            <ComboBox fx:id="cbCuentas" onAction="#cambiarCuenta" prefWidth="150.0" />
         </children>
      </HBox>
      <HBox alignment="CENTER" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="26.0" prefWidth="539.0">
         <children>
            <Button mnemonicParsing="false" onAction="#filtrarTransaccion" prefHeight="31.0" prefWidth="111.0" style="-fx-background-color: #00A9FF; -fx-text-fill: white;" text="Filtrar">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Region prefHeight="26.0" prefWidth="126.0" />
            <Button mnemonicParsing="false" onAction="#mostrarTransacciones" style="-fx-background-color: #00A9FF; -fx-text-fill: white;" text="Mostrar Todo">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
         </children>
      </HBox>
        <HBox prefHeight="21.0" prefWidth="740.0">
            <children>
                <Label fx:id="lblNombre" prefHeight="27.0" prefWidth="603.0" text="Carlos, bienvenido a su billetera virtual, aquí podrá ver sus transacciones" textAlignment="JUSTIFY">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblCuenta" alignment="TOP_RIGHT" contentDisplay="RIGHT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="21.0" prefWidth="172.0" text="Nro. Cuenta: 9067571744" textAlignment="JUSTIFY">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        <TableView fx:id="tablaTransacciones" editable="true" nodeOrientation="LEFT_TO_RIGHT" prefHeight="382.0" prefWidth="862.0" style="-fx-border-color: #00BFFF;">
            <columns>
                <TableColumn fx:id="txtIdTransaccion" prefWidth="75.0" text="idTransaccion" />
                <TableColumn fx:id="txtFecha" prefWidth="77.0" text="Fecha" />
                <TableColumn fx:id="txtMonto" prefWidth="77.0" text="Monto" />
                <TableColumn fx:id="txtUsuario" prefWidth="77.0" text="Usuario" />
                <TableColumn fx:id="txtTipoTransaccion" prefWidth="77.0" text="TipoTransacción" />
            <TableColumn fx:id="txtDescripcion" prefWidth="77.0" text="Descripción" />
            </columns>
            <cursor>
                <Cursor fx:constant="TEXT" />
            </cursor>
            <effect>
                <Blend />
            </effect>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER" focusTraversable="true" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#consultarSaldo" style="-fx-background-color: #00807a;" text="Consultar Saldo" textFill="WHITE" />
                <Region prefHeight="40.0" prefWidth="86.0" />
                <Button minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#irTransferencia" style="-fx-background-color: #00807a;" text="Transferir" textFill="WHITE" />
                <Region prefHeight="40.0" prefWidth="89.0" />
                <Button minHeight="40.0" minWidth="130.0" mnemonicParsing="false" onAction="#irGestionarCategorias" style="-fx-background-color: #00807a;" text="Gestionar Categorias" textFill="WHITE" />
            <Region prefHeight="40.0" prefWidth="90.0" />
            <Button minHeight="40.0" minWidth="142.0" mnemonicParsing="false" onAction="#irGestionarPresupuesto" style="-fx-background-color: #00807a; -fx-text-fill: white;" text="Gestionar Presupuestos" />
            </children>
        </HBox>
    </children>
</VBox>

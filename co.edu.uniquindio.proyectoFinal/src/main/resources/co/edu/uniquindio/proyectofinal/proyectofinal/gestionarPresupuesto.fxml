<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.viewController.GestionarPresupuestoViewController">
    <children>
        <HBox alignment="CENTER" prefHeight="62.0" prefWidth="600.0">
            <children>
                <Label text="Presupuestos Creados">
                    <font>
                        <Font name="System Bold Italic" size="26.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        <TableView fx:id="tablaPresupuestos" layoutX="32.0" layoutY="122.0" prefHeight="169.0" prefWidth="534.0">
            <columns>
                <TableColumn fx:id="tcIdPresupuesto" prefWidth="75.0" text="idPresupuesto" />
                <TableColumn fx:id="tcNombrePresupuesto" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="tcMontoAsignado" prefWidth="75.0" text="Monto Asignado" />
            <TableColumn fx:id="tcMontoGastado" prefWidth="75.0" text="Monto Gastado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label alignment="CENTER" layoutX="32.0" layoutY="52.0" prefHeight="62.0" prefWidth="534.0" text="Seleccione el presupuesto para actualizar o eliminar">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <Button layoutX="255.0" layoutY="325.0" mnemonicParsing="false" onAction="#IrActualizarPresupuesto" prefHeight="32.0" prefWidth="107.0" style="-fx-background-color: #D2F7FF;" text="Actualizar" />
        <Button layoutX="443.0" layoutY="325.0" mnemonicParsing="false" onAction="#eliminarPresupuesto" prefHeight="32.0" prefWidth="107.0" style="-fx-background-color: #D2F7FF;" text="Eliminar" />
      <Button layoutX="67.0" layoutY="325.0" mnemonicParsing="false" onAction="#IrCrearPresupuesto" prefHeight="32.0" prefWidth="107.0" style="-fx-background-color: #D2F7FF;" text="Crear" />
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.proyectofinal.proyectofinal.viewController.CategoriaViewController"
      prefHeight="400.0" prefWidth="400.0" alignment="center" spacing="30.0" >

    <Label text="Crear Categoria" >
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
        <Label text="Nombre Categoria:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCategoria" GridPane.columnIndex="1" GridPane.rowIndex="0" minHeight="30.0" />

        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="1" minHeight="30.0" />

    </GridPane>

    <Button text="Agregar" onAction="#Agregar" minHeight="40.0" minWidth="130.0" style="-fx-background-color: #00807a; -fx-text-fill: white" />

</VBox>
